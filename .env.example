# Copy to .env and fill in real values locally.
# DO NOT commit a populated .env file.

# --- Backend ---
APP_NAME=rag-backend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Frontend ---
# (Vite reads variables prefixed with VITE_)
VITE_API_BASE_URL=http://localhost:8000

# --- LLM provider (Phase 6.4) ---
# OpenAI-compatible provider, read from environment / backend/.env.
# Configured when LLM_API_KEY is set (OpenAI or any hosted compatible
# endpoint) OR when LLM_BASE_URL points at a local compatible server
# (Ollama / LM Studio / vLLM - no key required).
# Never put a real key here; fill in your local .env instead.
LLM_PROVIDER=openai_compatible
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60.0

# --- STT provider ---
# OpenAI-compatible Whisper provider, read from environment / backend/.env.
# Configured when STT_API_KEY (or LLM_API_KEY) is set OR when STT_BASE_URL is set.
STT_PROVIDER=openai_whisper
STT_API_KEY=
STT_BASE_URL=
STT_MODEL=whisper-1
STT_LANGUAGE=
STT_TIMEOUT_SECONDS=30.0
STT_MAX_AUDIO_SIZE_MB=10.0

# --- RAG index (Phase 5.3) ---
# Persisted index directory, vector store backend, embedding model, and
# retrieval defaults. Read from environment / backend/.env.
# The index is built with `python -m scripts.build_index` (from backend/).
RAG_INDEX_DIR=
RAG_VECTOR_STORE=faiss
RAG_EMBEDDING_MODEL=intfloat/multilingual-e5-small
RAG_EMBEDDING_DEVICE=auto
RAG_TOP_K=5

