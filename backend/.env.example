# Backend environment variables (placeholders only - do not commit real secrets)
APP_NAME=rag-backend

# Comma-separated list of allowed CORS origins for local development
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# STT provider configuration (Phase 7)
STT_PROVIDER=openai_whisper
STT_API_KEY=
STT_BASE_URL=
STT_MODEL=whisper-1
STT_LANGUAGE=
STT_TIMEOUT_SECONDS=30.0
STT_MAX_AUDIO_SIZE_MB=10.0

# RAG index configuration (Phase 5.3)
# Directory of the persisted RAG index (built by `python -m scripts.build_index`).
# Relative paths resolve against the backend root, NOT the working directory, so
# `data/index` means backend/data/index wherever the process is started from.
# Leave blank to use the default (backend/data/index).
RAG_INDEX_DIR=
# Vector store backend the index must use: 'faiss' or 'numpy'
RAG_VECTOR_STORE=faiss
# Embedding model the index must have been built with
RAG_EMBEDDING_MODEL=intfloat/multilingual-e5-small
# Embedding inference device: 'auto', 'cpu', or 'cuda'/'cuda:N'
RAG_EMBEDDING_DEVICE=auto
# Default number of nearest neighbors to retrieve
RAG_TOP_K=5

